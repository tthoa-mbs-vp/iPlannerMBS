# API requests use the Vite dev proxy (same origin) so the app works from any
# machine without opening the PocketBase port (8090) to the outside.
# In Docker, docker-compose.yml overrides VITE_PB_UPSTREAM with the container
# name: VITE_PB_UPSTREAM=http://pocketbase:8090
VITE_PB_UPSTREAM=http://localhost:8090
